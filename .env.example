# Skopiuj ten plik jako ".env" i uzupelnij ponizsze wartosci.
# Plik ".env" nigdy nie powinien byc nigdzie wysylany/commitowany.

# Discord Developer Portal (discord.com/developers/applications)
# -> Twoja aplikacja "Gatekey" -> OAuth2 -> General
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord Developer Portal -> Twoja aplikacja -> Bot -> Reset Token
DISCORD_BOT_TOKEN=

# W Discordzie: Ustawienia uzytkownika -> Zaawansowane -> wlacz "Tryb dewelopera",
# potem PPM na docelowy serwer -> "Kopiuj ID serwera",
# oraz PPM na docelowa role (Ustawienia serwera -> Role) -> "Kopiuj ID roli"
DISCORD_GUILD_ID=
DISCORD_REQUIRED_ROLE_ID=

# Musi dokladnie pasowac do adresu przekierowania dodanego w Developer Portal
# (OAuth2 -> General -> Redirects): http://localhost:47624/callback
DISCORD_REDIRECT_PORT=47624
